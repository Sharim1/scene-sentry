# ============================================================
# Scene Sentry — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- App ---
DEBUG=false
ENV=development
SECRET_KEY=change-me-to-a-random-string
SESSION_SECRET=change-me-to-a-different-random-string

# --- Database ---
DATABASE_URL=postgresql://scenesentry:scenesentry@localhost:5432/scenesentry

# --- Clerk Auth (optional — omit to use local username/password auth) ---
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_WEBHOOK_SECRET=whsec_...
# CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://localhost:8000,https://yourdomain.com

# --- AI APIs ---
# GEMINI_API_KEY=your-gemini-api-key
# TAVILY_API_KEY=tvly-...

# --- Content Providers ---
# TVDB_API_KEY=your-tvdb-api-key
# OMDB_API_KEY=your-omdb-api-key
# TVMAZE_API_KEY=               # Optional — TVMaze public API works without a key
# TMDB_API_KEY=your-tmdb-api-key
# TMDB_ENABLED=false            # Requires commercial license for revenue projects
TVDB_ENABLED=true
OMDB_ENABLED=true
TVMAZE_ENABLED=true

# --- Email (optional — contact form logs to console if not configured) ---
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_FROM_EMAIL=noreply@mg.yourdomain.com
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Scene Sentry <noreply@alerts.yourdomain.com>

# --- Contact Form ---
# CONTACT_TO_EMAIL=you@yourdomain.com

# --- Background Task Intervals (defaults are fine for most setups) ---
# GOSSIP_SCRAPE_INTERVAL_MINUTES=30
# RERANKING_INTERVAL_MINUTES=120
# DISCOVERY_INTERVAL_HOURS=6
# DISCOVERY_BATCH_SIZE=10
# ENRICHMENT_INTERVAL_MINUTES=15
# REMINDER_CHECK_INTERVAL_MINUTES=1

# --- Rate Limiting ---
# RATE_LIMIT_AUTH=5/minute
# RATE_LIMIT_API=60/minute
