# Version control / CI
.git
.github

# Secrets and local env (never bake into the image). Patterns are anchored to
# the context root, so the **/ forms also catch nested copies such as deploy/oracle/.env.
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
deploy
ubuntu@*

# Python virtualenv and caches
.venv
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache

# Node deps (reinstalled in the Dockerfile assets stage).
node_modules

# Local databases / broker dumps
*.db
dump.rdb
celerybeat-schedule
celerybeat-schedule.*

# Tests, docs, and design scratch — not needed at runtime
tests
docs
temp_design_directory_for_reference

# Coverage / misc
coverage.xml
htmlcov
.coverage
.DS_Store
