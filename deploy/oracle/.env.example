# Copy to deploy/oracle/.env on the Oracle box and fill in. Never commit the real file.

# Neon connection string for the production branch (psycopg2 format).
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require

# Password for the Redis instance on this box (used by worker and beat).
REDIS_PASSWORD=change-me

# Remaining app settings (Clerk, Gemini, Tavily, OMDb, TVDB, TVMaze, Resend, SECRET_KEY, ENV=production, ...)
# must match what FastAPI Cloud uses. Copy them over, but leave out the web-only ones.
